#!/bin/sh
# Mount all filesystems
mount -a

# ncurses programs need this.
export TERMINFO=/usr/share/terminfo

if [ ! -d /var/tmp ]; then
    mkdir -m a+rwx /var/tmp
fi

echo "preparing networking..."
if [ -e /etc/hostname ]; then
    hostname -F /etc/hostname
fi
ifup -a

echo "running rc.d services..."

run-parts -a start /etc/rc.d
echo -n "uptime idle: "; cat /proc/uptime

mount /dev/vda /data -t ext4

echo "creating uos network tunnel..."
nohup socat TCP-LISTEN:8022,fork,reuseaddr  TCP:192.168.2.2:22 > /dev/null 2>&1  &
nohup socat TCP-LISTEN:8023,fork,reuseaddr  TCP:192.168.1.2:22 > /dev/null 2>&1  &
nohup socat TCP-LISTEN:5201,fork,reuseaddr  TCP:192.168.1.2:5201 > /dev/null 2>&1  &

# announce rproc remote ready
echo 1 > /sys/devices/platform/b00000000.nebula_rproc_remote0/ready

/bin/rprocd &
